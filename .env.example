# 複製成 .env.local 後填值。這個檔案只放「變數名稱」,絕對不要填真實值再 commit。
# 正式環境的值請設定在 Vercel → Project → Settings → Environment Variables。

# Auth.js:隨機長字串,可用 `npx auth secret` 或 `openssl rand -base64 32` 產生
AUTH_SECRET=

# GitHub OAuth App(GitHub → Settings → Developer settings → OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# 白名單:只允許這個 GitHub 帳號。ALLOWED_GITHUB_ID 是數字 id(強烈建議填,改名也不會被冒用)
ALLOWED_GITHUB_LOGIN=Yukine1118
ALLOWED_GITHUB_ID=

# Supabase — secret key(sb_secret_… 或舊版 service_role)只能放伺服器端,不可加 NEXT_PUBLIC_ 前綴
# 兩個都沒設定時,網站顯示 DEMO 資料(本機開發/測試用)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub 唯讀 token(第 6 階段才需要,fine-grained,只給 read 權限)
GITHUB_READ_TOKEN=

# 自動匯入 POST /api/ingest 的 Bearer token。沒設定時端點回 503,不接受寫入。
# 用 openssl rand -base64 32 產生,只放 Vercel(敏感)與本機環境,不要寫進設定檔。
# 本機上傳腳本讀的是另一個變數 AIWR_INGEST_TOKEN(同一個值,不放這裡)。
INGEST_TOKEN=
